# Copier ce fichier sous le nom .env (jamais dans le dépôt GitHub) et le remplir.
SITE_URL=https://transport.galan-ga.com
# Même valeur que 'jeton_robot' dans config.php du site (au moins 24 caractères au hasard).
JETON_ROBOT=
# Identifiants Station Chargeur (XPO).
XPO_IDENTIFIANT=
XPO_MOT_DE_PASSE=
# repetition = remplit le formulaire puis annule (essais) ; reel = valide et crée l'expédition.
MODE=repetition
# Vérification de la file d'attente toutes les N secondes.
INTERVALLE=60
